      "title": "AcPhase",
      "type": "object"
    },
    "Alarm": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "What the alarm is about, worded for the person reading it.",
          "type": "string"
        },
        "level": {
          "enum": [
            "warning",
            "alarm"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "level"
      ],
      "title": "Alarm",
      "type": "object"
    },
    "AlarmCheck": {
      "additionalProperties": false,
